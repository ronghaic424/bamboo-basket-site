# 复制为 .env 后填写；本地预览用 node --env-file=.env preview.mjs

# ---- SQLite ----
# node:sqlite 数据库文件路径（默认 data/zhuliji.sqlite）；线上若绑定 D1（env.DB）则自动改用 D1
SQLITE_PATH=data/zhuliji.sqlite

# ---- 后台管理员（首次启动时写入 admin_users 表，修改密码后重启即生效）----
# 未配置这两项则后台登录直接返回 503，不再有内置测试密码
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=请改成足够长的随机口令
ADMIN_NAME=竹里集管理员

# ---- 连连全球收单（沙箱联调用）----
LIANLIAN_MERCHANT_ID=
LIANLIAN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
LIANLIAN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
LIANLIAN_ENV=sandbox
LIANLIAN_SITE_URL=http://127.0.0.1:4173

# ---- Cloudflare 部署（npm run deploy:cf）----
# 二选一：本地 npx wrangler login，或在这里放 API Token / Account ID
# Token 需具备 Workers Scripts:Edit 与 D1:Edit 权限
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# 正式域名。留空时脚本会自动读取 wrangler.toml 里 [[routes]] 的 pattern，
# 并写回 vars.LIANLIAN_SITE_URL（支付回调地址以它为准）
SITE_URL=https://shop.naturalbamboo.app
