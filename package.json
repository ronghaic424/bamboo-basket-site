{
  "name": "sites-worker-esm-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash scripts/build.sh",
    "validate": "node scripts/validate-artifact.mjs",
    "preview": "node --no-warnings preview.mjs",
    "smoke": "node --no-warnings scripts/smoke-test.mjs",
    "deploy:cf": "node scripts/deploy-cloudflare.mjs",
    "deploy:cf:dry": "node scripts/deploy-cloudflare.mjs --dry-run",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "cf:db:create": "wrangler d1 create zhuliji-db",
    "cf:dev": "wrangler dev",
    "cf:tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.162.0"
  }
}
